{
  "name": "skrypt-web",
  "private": true,
  "version": "1.2.5",
  "description": "A demo web implementation of the Skrypt language",
  "homepage": "https://yabobjonez.github.io/skrypt",
  "repository": "https://github.com/yaBobJonez/skrypt-web",
  "bugs": "https://github.com/yaBobJonez/skrypt-web/issues",
  "author": "Mykhailo Stetsiuk",
  "license": "SEE LICENSE IN public/",
  "type": "module",
  "scripts": {
    "antlr": "antlr-ng --lib grammar -o lib --exact-output-dir -v true -l false grammar/SkryptParser.g4 grammar/SkryptLexer.g4",
    "dev": "tsc && vite",
    "test": "vitest run",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/view": "^6.41.1",
    "@olton/metroui": "^5.1.20",
    "@types/node": "^25.6.0",
    "antlr4ng": "^3.0.16",
    "codemirror": "^6.0.2",
    "codemirror-lang-skrypt": "^1.3.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
