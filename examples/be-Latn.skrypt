# Latin Belarusian
# ================

@ taraskCompat = true
@ separateW = true

% c			= <бвгґджзклмнпрстўфхцчш>
% v			= <аеёіоуыэюя>
% letters	= {v}|{c}|<йь>

а	→	a
б	→	b
в	→	v
г	→	h	? taraskCompat
г	→	g
ґ	→	g
д	→	d
[{c}]е	→	ie
[й]е	→	e
е		→	je
[{c}]ё	→	io
[й]ё	→	o
ё		→	jo
ж	→	ž
з	→	z
і	→	i
й	→	j
к	→	k
л	→	l
м	→	m
н	→	n
о	→	o
п	→	p
р	→	r
с	→	s
т	→	t
у	→	u
ў[{v}],
[_]ў/	→	w	? separateW
ў		→	ŭ
ф	→	f
х	→	ch
ц	→	c
ч	→	č
ш	→	š
ы	→	y
ь	→	\u0301
э	→	e
[{c}]ю	→	iu
[й]ю	→	u
ю		→	ju
[{c}]я	→	ia
[й]я	→	a
я		→	ja
<\'ʼ’>	→	{}
