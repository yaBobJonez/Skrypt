# Cyrillic French
# ===============

@ compatMode		= true
@ tryToGuessE		= true
@ yerSolidification	= 0
@ removeFinalNasals	= false
@ phoneticize		= true

% svy		= <eéèêëiîïyÿ>
% vy		= <aàâæoôœuûùü>|{svy}
% c			= <bcçdfghjklmnpqrstvwxz>
% cy		= {c}|y
% letters	= {c}|{vy}


